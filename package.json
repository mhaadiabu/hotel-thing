{
  "name": "hotel",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "lint:typecheck": "TSRS_FAST=1 oxlint --type-aware --type-check",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F @hotel/backend",
    "dev:setup": "turbo run dev:setup -F @hotel/backend",
    "check": "oxlint && oxfmt --write"
  },
  "dependencies": {
    "@hotel/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hotel/config": "workspace:*",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsrs": "catalog:",
    "turbo": "^2.11.13"
  },
  "packageManager": "pnpm@11.17.0"
}